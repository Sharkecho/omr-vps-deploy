# =============================================================================
# omr-vps-deploy / omr.env
#
# 用法：复制成 /root/omr-deploy/omr.env（或仓库目录下的 omr.env），
#       部署脚本会自动装载；命令行环境变量优先级最高。
#
#       cp omr.env.example /root/omr-deploy/omr.env
#       vi  /root/omr-deploy/omr.env
#       bash deploy.sh
# =============================================================================

# ---- 版本 pin ---------------------------------------------------------------
# v0.1052 = 这台服务器此前与路由器（OMR v0.63-6.12）正常对接的版本。
# 换版本：v0.1082 / v0.1071 / master（master = 官方最新，功能新但已经过的验证少）
OMR_VERSION=v0.1052

# ---- 内核线 -----------------------------------------------------------------
# 路由器固件是 v0.63-6.12 → 服务端用同一条 6.12 线。
# 可选：5.4 / 6.1 / 6.6 / 6.10 / 6.11 / 6.12 / 6.18
# 说明：安装器会装 xanmod-mptcp 内核并尽量把 grub 默认项切过去；
#       若这台 VPS 由服务商宿主直启（不走 grub），换内核是空操作，重启后仍是原内核。
KERNEL=6.12

# ---- 安装行为 ---------------------------------------------------------------
UPDATE=yes            # 已有安装时按"更新"处理（不重新生成密钥）
REINSTALL=yes         # 即使版本相同也重跑
FAIL2BAN=yes          # SSH / OpenVPN / omr-admin / Xray / SS-Go 的封禁
OMR_ADMIN=yes         # 路由器 Web UI 依赖的 REST API（65500）
OMR_METRICS=no        # 指标采集（可选）
OMR_AI=no             # AI 预测插件（可选）
SOURCES=no            # no = 用预编译包（快、稳）；yes = 从源码编译（慢、要工具链）
CHINA=no              # 印度/海外 VPS 用 no；走国内镜像时才 yes
TLS=yes               # 有可用域名时才真正签发 ACME 证书，否则自动跳过

# ---- 隧道/代理开关（按需裁剪，默认按官方默认）-------------------------------
SHADOWSOCKS=yes
SHADOWSOCKS_GO=yes
V2RAY=yes
XRAY=yes
GLORYTUN_TCP=yes
GLORYTUN_UDP=yes
DSVPN=yes
MLVPN=yes
UBOND=no
MQVPN=yes
WIREGUARD=yes
OPENVPN=yes
OPENVPN_BONDING=yes
SOFTETHERVPN=no

# ---- 网络接口 / 域名（不确定就别填，脚本会自己探测）-------------------------
# INTERFACE=eth0
# INTERFACE6=eth0
# VPS_DOMAIN=vpn.example.com
# VPS_PUBLIC_IP=172.236.187.101
